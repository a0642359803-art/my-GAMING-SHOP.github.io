const SB_URL='https://edgjwfuezwucpylghoww.supabase.co',SB_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVkZ2p3ZnVlend1Y3B5bGdob3d3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMyNjg4NTQsImV4cCI6MjEwODg0NDg1NH0.Seg0EJOH9drWoy_nl0EUkM-Sxm8VNy5ADLS2Ub5xLc8';
